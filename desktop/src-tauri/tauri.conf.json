{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "9Drive",
  "version": "0.1.0",
  "identifier": "engineer.badry.ninedrive",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../../frontend/dist-desktop",
    "beforeDevCommand": "npm --prefix ../frontend run dev:desktop",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop"
  },
  "app": {
    "windows": [
      {
        "title": "9Drive",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' https://cdnjs.cloudflare.com https://www.google.com https://www.gstatic.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; connect-src 'self' ipc: http://ipc.localhost https: http:; frame-src https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "category": "Productivity",
    "shortDescription": "9Drive storage gateway",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": { "schemes": ["ninedrive"] }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDVBMkRBQUNGQzA2NDNFQjEKUldTeFBtVEF6Nm90V3RmWHFqd0hCYmMrRDNyaC9PTVllRzRTcTEwZi9vQWxLdEt6UmpZZHdQTHgK",
      "endpoints": ["https://github.com/BadryansahBangsawan/9drive/releases/latest/download/latest.json"]
    }
  }
}
